2026-11-06T16:10:53.4564087Z         self.decision = ''
2026-11-06T16:10:53.4564551Z     def handle_starttag(self, tag, attrs):
2026-11-06T16:10:53.4565233Z         attrs = dict(attrs)
2026-11-06T16:10:53.4565948Z         classes = attrs.get('class', '').split()
2026-11-06T16:10:53.4566460Z         self.cells += 'cell' in classes
2026-11-06T16:10:53.4566949Z         self.robots += 'robot' in classes
2026-11-06T16:10:53.4567435Z         self.rows += tag == 'tr'
2026-11-06T16:10:53.4567901Z         self.candidates += tag == 'li'
2026-11-06T16:10:53.4568393Z         if attrs.get('id') == 'metrics':
2026-11-06T16:10:53.4568870Z             self.in_metrics = True
2026-11-06T16:10:53.4569345Z         if attrs.get('id') == 'decision':
2026-11-06T16:10:53.4569823Z             self.in_decision = True
2026-11-06T16:10:53.4570294Z     def handle_endtag(self, tag):
