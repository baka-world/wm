2026-11-06T16:10:53.4571185Z             self.in_metrics = False
2026-11-06T16:10:53.4571662Z             self.in_decision = False
2026-11-06T16:10:53.4572127Z     def handle_data(self, data):
2026-11-06T16:10:53.4572587Z         if self.in_metrics:
